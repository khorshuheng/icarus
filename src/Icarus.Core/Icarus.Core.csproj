<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Icarus.Core</RootNamespace>
    <AssemblyName>Icarus.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>The ICARUS agent engine: runtime, tools, providers, config, session and skills. Terminal-free.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- ICARUS-105: TOML config. -->
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <!-- ICARUS-102: the MEAI provider seam and the two official backends. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.7" />
    <PackageReference Include="AWSSDK.Extensions.Bedrock.MEAI" Version="4.0.101.8" />
    <PackageReference Include="Anthropic" Version="12.49.0" />
    <!-- ICARUS-102: OpenAI-compatible client for DeepSeek. -->
    <PackageReference Include="OpenAI" Version="2.14.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.10.0" />
  </ItemGroup>

</Project>
