<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Icarus.Cli</RootNamespace>
    <AssemblyName>icarus</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>The ICARUS TUI frontend.</Description>
    <!-- ICARUS-107: Terminal.Gui 2.5 marks the static Application object and
         TextView obsolete in favour of Application.Create()/EditorView. The
         legacy API still functions; migrating is a follow-up (ICARUS-110). -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Icarus.Core\Icarus.Core.csproj" />
    <!-- ICARUS-107: TUI + display-width-aware caret. -->
    <PackageReference Include="Terminal.Gui" Version="2.5.0" />
    <PackageReference Include="Wcwidth" Version="4.0.1" />
    <!-- ICARUS-109: CommonMark rendering. -->
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>

</Project>
