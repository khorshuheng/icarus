<Project>
  <!-- Shared build policy for every ICARUS project (ICARUS-101). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Product>ICARUS</Product>
    <Authors>khorshuheng</Authors>
    <!-- ICARUS targets Linux only (ICARUS-100 decision 5): publish with
         `-r linux-x64` / `-r linux-arm64` (ICARUS-110). -->
  </PropertyGroup>
</Project>
